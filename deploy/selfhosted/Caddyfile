# Sitio estático del cliente con HTTPS automático. {$DOMINIO} viene de .env (p. ej. www.cliente.cl).
{
	email {$CORREO_ACME}
}

{$DOMINIO} {
	root * /srv/sitio
	encode zstd gzip
	file_server
	handle_errors {
		root * /srv/sitio
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
	# Equivalente a _headers. La Content-Security-Policy depende de cada cliente (Supabase, fuentes):
	# copia aquí la línea de dist/<slug>/_headers como:  Content-Security-Policy "default-src 'self'; …"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	@hashed path /assets/js/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"
}
